{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KASA Core Intent",
  "description": "Strict contract the intent parser must emit. The parser fills slots; it NEVER executes. Execution is gated on explicit user confirmation in the app.",
  "type": "object",
  "required": ["action", "confidence", "needs_confirmation", "transcript", "language"],
  "additionalProperties": false,
  "properties": {
    "action": { "type": "string", "enum": ["check_balance","send_money","buy_data","buy_airtime","cash_out","pay_merchant","unknown"] },
    "amount": { "type": ["number","null"], "description": "Amount in GHS. null when not applicable/not captured." },
    "recipient": {
      "type": ["object","null"], "additionalProperties": false,
      "properties": {
        "raw": { "type": "string" },
        "matched_contact": { "type": ["string","null"] },
        "number": { "type": ["string","null"] }
      }
    },
    "extra": { "type": "object", "additionalProperties": true },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "Below threshold (e.g. 0.6) => re-ask; never guess." },
    "needs_confirmation": { "type": "boolean", "description": "Always true for money/data actions. App must speak+display a summary and get explicit approval before the USSD engine runs." },
    "transcript": { "type": "string" },
    "language": { "type": "string", "enum": ["tw","en","mixed"] }
  }
}
